{% liquid
  assign current_product = product | default: section.settings.product | default: closest.product
%}

<script
  src="{{ 'main-product.js' | asset_url }}"
  type="module"
></script>

{% if current_product != blank %}
  <script type="application/ld+json">
    {{ current_product | structured_data }}
  </script>
{% endif %}

{% if current_product != blank %}
  {% render 'product-page-content',
    product: current_product,
    section_id: section.id,
    section_settings: section.settings
  %}
{% endif %}

{% schema %}
{
  "name": "Main product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "Page width"
        },
        {
          "value": "content-full-width",
          "label": "Full width"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "Desktop media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Trust indicators"
    },
    {
      "type": "checkbox",
      "id": "enable_stock_urgency",
      "label": "Show low stock callout",
      "default": true
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "label": "Stock threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "trust_badge_1",
      "label": "Trust badge 1",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "trust_badge_2",
      "label": "Trust badge 2",
      "default": "Free returns"
    },
    {
      "type": "text",
      "id": "trust_badge_3",
      "label": "Trust badge 3",
      "default": "Secure checkout"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}
