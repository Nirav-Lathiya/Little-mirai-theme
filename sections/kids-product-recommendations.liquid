{% comment %}
  Kids Product Recommendations - Custom recommendations section
  Features: 4 columns, discount badge, hover effects, quick add
{% endcomment %}

{% liquid
  assign collection = section.settings.recommendation_collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign show_discount_badge = section.settings.show_discount_badge
  
  if collection == blank
    assign products = collections.all.products | slice: 0, products_to_show
  else
    assign products = collection.products | slice: 0, products_to_show
  endif
%}

<div class="kids-product-recommendations">
  <div class="kids-product-recommendations__container">
    <h2 class="kids-product-recommendations__title">{{ section.settings.heading | default: 'Parents also bought' }}</h2>
    
    {% if products.size > 0 %}
      <div class="kids-product-recommendations__grid">
        {% for product in products %}
          <div class="kids-rec-product-card">
            <a href="{{ product.url }}" class="kids-rec-product-card__link">
              <div class="kids-rec-product-card__image-wrap">
                <!-- Discount Badge -->
                {% if show_discount_badge and product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="kids-rec-product-card__badge">-{{ discount_percent }}%</span>
                {% endif %}
                
                <!-- Product Image -->
                {% if product.featured_image != blank %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 400 }}" 
                    alt="{{ product.title }}"
                    class="kids-rec-product-card__image"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {% else %}
                  <div class="kids-rec-product-card__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'kids-rec-product-card__placeholder-img' }}
                  </div>
                {% endif %}
                
                <!-- Quick Add Button (on hover) -->
                <div class="kids-rec-product-card__quick-add">
                  {% if product.variants.size == 1 %}
                    <button 
                      class="kids-rec-product-card__quick-add-btn"
                      onclick="event.preventDefault(); event.stopPropagation(); kidsQuickAdd({{ product.variants.first.id }})"
                    >
                      Quick Add
                    </button>
                  {% else %}
                    <button 
                      class="kids-rec-product-card__quick-add-btn"
                      onclick="event.preventDefault(); event.stopPropagation(); window.location.href='{{ product.url }}'"
                    >
                      Select Options
                    </button>
                  {% endif %}
                </div>
              </div>
              
              <!-- Product Info -->
              <div class="kids-rec-product-card__info">
                <h3 class="kids-rec-product-card__title">{{ product.title }}</h3>
                <div class="kids-rec-product-card__price">
                  <span class="kids-rec-product-card__price-current">
                    {{ product.price | money }}
                  </span>
                  {% if product.compare_at_price > product.price %}
                    <span class="kids-rec-product-card__price-compare">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="kids-product-recommendations__empty">No products found.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Kids Recommendations",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "recommendation_collection",
      "label": "Collection",
      "info": "Select a collection to display products from. If empty, shows products from 'All Products'."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Parents also bought"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge",
      "default": true,
      "info": "Shows a discount percentage badge on products with compare-at price"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Kids Recs"
    }
  ]
}
{% endschema %}

<style>
.kids-product-recommendations {
  padding-top: 48px;
  padding-bottom: 48px;
  background: rgb(var(--color-background-rgb));
}

.kids-product-recommendations__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

.kids-product-recommendations__title {
  font-size: 1.75rem;
  font-weight: 700;
  margin: 0 0 2rem;
  color: rgb(var(--color-foreground));
}

.kids-product-recommendations__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

@media (max-width: 1024px) {
  .kids-product-recommendations__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 749px) {
  .kids-product-recommendations__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  
  .kids-product-recommendations__container {
    padding: 0 1rem;
  }
  
  .kids-product-recommendations__title {
    font-size: 1.5rem;
  }
}

/* Product Card */
.kids-rec-product-card {
  position: relative;
}

.kids-rec-product-card__link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.kids-rec-product-card__image-wrap {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: rgb(var(--color-background-rgb) / 0.5);
  aspect-ratio: 1;
  margin-bottom: 0.75rem;
}

.kids-rec-product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.kids-rec-product-card:hover .kids-rec-product-card__image {
  transform: scale(1.05);
}

.kids-rec-product-card:hover {
  box-shadow: 0 8px 24px rgb(var(--color-foreground-rgb) / 0.12);
}

.kids-rec-product-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kids-rec-product-card__placeholder-img {
  width: 60%;
  height: 60%;
}

/* Discount Badge */
.kids-rec-product-card__badge {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  background: #b06464;
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.35rem 0.6rem;
  border-radius: 6px;
}

/* Quick Add Button */
.kids-rec-product-card__quick-add {
  position: absolute;
  bottom: 0.75rem;
  left: 0.75rem;
  right: 0.75rem;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.kids-rec-product-card:hover .kids-rec-product-card__quick-add {
  opacity: 1;
  transform: translateY(0);
}

.kids-rec-product-card__quick-add-btn {
  width: 100%;
  height: 40px;
  background: rgb(var(--color-background-rgb));
  color: rgb(var(--color-foreground));
  border: none;
  border-radius: 10px;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.kids-rec-product-card__quick-add-btn:hover {
  background: rgb(var(--color-foreground-rgb) / 0.1;
}

/* Product Info */
.kids-rec-product-card__info {
  padding: 0 0.25rem;
}

.kids-rec-product-card__title {
  font-size: 0.9375rem;
  font-weight: 600;
  margin: 0 0 0.35rem;
  line-height: 1.3;
  color: rgb(var(--color-foreground));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kids-rec-product-card__price {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.kids-rec-product-card__price-current {
  font-size: 0.9375rem;
  font-weight: 600;
  color: rgb(var(--color-foreground));
}

.kids-rec-product-card__price-compare {
  font-size: 0.8125rem;
  text-decoration: line-through;
  color: rgb(var(--color-foreground-rgb) / 0.5);
}

.kids-product-recommendations__empty {
  text-align: center;
  color: rgb(var(--color-foreground-rgb) / 0.6);
  padding: 3rem 0;
}
</style>

<script>
function kidsQuickAdd(variantId) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      items: [{
        id: variantId,
        quantity: 1
      }]
    })
  })
  .then(response => response.json())
  .then(data => {
    // Refresh cart
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    
    // Open cart drawer if available
    if (typeof CartDrawer !== 'undefined') {
      CartDrawer.open();
    } else if (typeof document.querySelector('[data-cart-drawer]') !== 'undefined') {
      document.querySelector('[data-cart-drawer]').open();
    }
  })
  .catch(error => {
    console.error('Error adding to cart:', error);
  });
}
</script>
