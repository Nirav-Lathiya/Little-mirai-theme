{% liquid
  assign category_label = product.type | default: 'Baby Essential'
  assign story_heading = product.title
  assign story_intro = product.description | strip_html | truncate: 200
  assign highlight_title = 'Key Features'
  assign highlight_value = 'Premium Quality'
  assign highlight_copy = "Carefully designed for your little one's comfort and safety."
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--page-width kids-product-story color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="kids-product-story__layout">
    <div class="kids-product-story__visual">
      <div class="kids-product-story__image-wrap">
        {% if product.featured_image != blank %}
          {{
            product.featured_image
            | image_url: width: 1400
            | image_tag:
              alt: product.title,
              width: "1600",
              height: "1068",
              loading: 'lazy',
              class: 'kids-product-story__image'
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'kids-product-story__placeholder' }}
        {% endif %}
      </div>
      <div class="kids-product-story__floating-card">
        <span>{{ highlight_title }}</span>
        <strong>{{ highlight_value }}</strong>
        <p>{{ highlight_copy }}</p>
      </div>
    </div>

    <div class="kids-product-story__content">
      <span class="kids-product-story__eyebrow">{{ category_label }}</span>
      <h2>{{ story_heading }}</h2>
      <p class="kids-product-story__intro">{{ story_intro }}</p>

      <div class="kids-product-story__details">
        <div class="kids-product-story__detail-card">
          <h3>Product Details</h3>
          {% if product.description != blank %}
            <p>{{ product.description | strip_html | truncate: 300 }}</p>
          {% else %}
            <p>Discover quality essentials designed for your little one's comfort.</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .kids-product-story {
    display: grid;
  }

  .kids-product-story__layout {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }

  .kids-product-story__visual {
    position: relative;
  }

  .kids-product-story__image-wrap {
    overflow: hidden;
    border-radius: 32px;
    min-height: 100%;
    background:
      radial-gradient(circle at top left, rgb(255 255 255 / 0.72), transparent 40%),
      #f4ebe2;
    box-shadow: 0 24px 60px rgb(25 25 20 / 0.12);
  }

  .kids-product-story__image-wrap img {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    object-fit: cover;
  }

  .kids-product-story__floating-card {
    display: grid;
    gap: 0.45rem;
    margin-top: -2rem;
    margin-inline: 1rem;
    padding: 1.1rem 1.2rem;
    border-radius: 24px;
    background: rgb(var(--color-background-rgb) / 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    box-shadow: 0 14px 30px rgb(20 18 14 / 0.08);
  }

  .kids-product-story__floating-card span,
  .kids-product-story__eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .kids-product-story__floating-card strong {
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .kids-product-story__floating-card p,
  .kids-product-story__feature p,
  .kids-product-story__detail-card p,
  .kids-product-story__intro {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    line-height: 1.7;
  }

  .kids-product-story__content h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(2rem, 3vw, 3.35rem);
    line-height: 0.98;
    max-width: 14ch;
  }

  .kids-product-story__intro {
    margin-top: 1rem;
    max-width: 42rem;
  }

  .kids-product-story__features,
  .kids-product-story__details {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .kids-product-story__feature,
  .kids-product-story__detail-card {
    padding: 1.15rem 1.2rem;
    border-radius: 24px;
    background: linear-gradient(180deg, rgb(var(--color-background-rgb) / 0.96), rgb(var(--color-background-rgb) / 0.88));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .kids-product-story__feature h3,
  .kids-product-story__detail-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .kids-product-story__detail-card ul {
    margin: 0;
    padding-left: 1.1rem;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    line-height: 1.7;
  }

  @media screen and (min-width: 750px) {
    .kids-product-story__features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .kids-product-story__details {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  @media screen and (min-width: 990px) {
    .kids-product-story__layout {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .kids-product-story__floating-card {
      position: absolute;
      inset: auto 1.4rem 1.4rem auto;
      max-width: 18rem;
      margin: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kids Product Story",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Kids Product Story"
    }
  ]
}
{% endschema %}
