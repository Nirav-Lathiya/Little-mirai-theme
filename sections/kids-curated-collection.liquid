{% liquid
  assign product_1_link = section.settings.product_1_link
  assign product_2_link = section.settings.product_2_link
  assign product_3_link = section.settings.product_3_link
  assign product_4_link = section.settings.product_4_link
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--page-width kids-curated-collection color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="kids-curated-collection__header">
    <div class="kids-curated-collection__copy">
      <span class="kids-curated-collection__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>
    <div class="kids-curated-collection__note">
      <span>{{ section.settings.note_label }}</span>
      <strong>{{ section.settings.note_value }}</strong>
    </div>
  </div>

  <div class="kids-curated-collection__grid">
    <article class="kids-curated-collection__card">
      <div class="kids-curated-collection__media">
        <img
          src="{{ 'kids-diaper-cactus.jpg' | asset_url }}"
          alt="{{ section.settings.product_1_title }}"
          width="1200"
          height="801"
          loading="lazy"
        >
      </div>
      <div class="kids-curated-collection__body">
        <div class="kids-curated-collection__meta">
          <span class="kids-curated-collection__badge">{{ section.settings.product_1_badge }}</span>
          <span class="kids-curated-collection__price">{{ section.settings.product_1_price }}</span>
        </div>
        <h3>{{ section.settings.product_1_title }}</h3>
        <p>{{ section.settings.product_1_description }}</p>
        {% if product_1_link != blank %}
          <a href="{{ product_1_link }}" class="kids-curated-collection__link">View details</a>
        {% endif %}
      </div>
    </article>

    <article class="kids-curated-collection__card">
      <div class="kids-curated-collection__media">
        <img
          src="{{ 'kids-diaper-owl.jpg' | asset_url }}"
          alt="{{ section.settings.product_2_title }}"
          width="1200"
          height="900"
          loading="lazy"
        >
      </div>
      <div class="kids-curated-collection__body">
        <div class="kids-curated-collection__meta">
          <span class="kids-curated-collection__badge">{{ section.settings.product_2_badge }}</span>
          <span class="kids-curated-collection__price">{{ section.settings.product_2_price }}</span>
        </div>
        <h3>{{ section.settings.product_2_title }}</h3>
        <p>{{ section.settings.product_2_description }}</p>
        {% if product_2_link != blank %}
          <a href="{{ product_2_link }}" class="kids-curated-collection__link">View details</a>
        {% endif %}
      </div>
    </article>

    <article class="kids-curated-collection__card">
      <div class="kids-curated-collection__media">
        <img
          src="{{ 'kids-socks-flatlay.jpg' | asset_url }}"
          alt="{{ section.settings.product_3_title }}"
          width="1200"
          height="830"
          loading="lazy"
        >
      </div>
      <div class="kids-curated-collection__body">
        <div class="kids-curated-collection__meta">
          <span class="kids-curated-collection__badge">{{ section.settings.product_3_badge }}</span>
          <span class="kids-curated-collection__price">{{ section.settings.product_3_price }}</span>
        </div>
        <h3>{{ section.settings.product_3_title }}</h3>
        <p>{{ section.settings.product_3_description }}</p>
        {% if product_3_link != blank %}
          <a href="{{ product_3_link }}" class="kids-curated-collection__link">View details</a>
        {% endif %}
      </div>
    </article>

    <article class="kids-curated-collection__card">
      <div class="kids-curated-collection__media">
        <img
          src="{{ 'kids-socks-feet.jpg' | asset_url }}"
          alt="{{ section.settings.product_4_title }}"
          width="1200"
          height="800"
          loading="lazy"
        >
      </div>
      <div class="kids-curated-collection__body">
        <div class="kids-curated-collection__meta">
          <span class="kids-curated-collection__badge">{{ section.settings.product_4_badge }}</span>
          <span class="kids-curated-collection__price">{{ section.settings.product_4_price }}</span>
        </div>
        <h3>{{ section.settings.product_4_title }}</h3>
        <p>{{ section.settings.product_4_description }}</p>
        {% if product_4_link != blank %}
          <a href="{{ product_4_link }}" class="kids-curated-collection__link">View details</a>
        {% endif %}
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .kids-curated-collection {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .kids-curated-collection__header {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .kids-curated-collection__copy {
    max-width: 42rem;
  }

  .kids-curated-collection__copy h2,
  .kids-curated-collection__copy p {
    margin: 0;
  }

  .kids-curated-collection__copy h2 {
    font-size: clamp(2rem, 3vw, 3.25rem);
    line-height: 1;
    margin-top: 0.45rem;
  }

  .kids-curated-collection__copy p {
    color: rgb(var(--color-foreground-rgb) / 0.72);
    margin-top: 0.9rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .kids-curated-collection__eyebrow,
  .kids-curated-collection__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: rgb(var(--color-foreground-rgb) / 0.76);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 0.8rem;
  }

  .kids-curated-collection__note {
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    border-radius: 24px;
    background: linear-gradient(180deg, rgb(var(--color-background-rgb) / 0.94), rgb(var(--color-background-rgb) / 0.82));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    justify-self: start;
  }

  .kids-curated-collection__note span {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.58);
  }

  .kids-curated-collection__note strong {
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .kids-curated-collection__grid {
    display: grid;
    gap: 1.2rem;
  }

  .kids-curated-collection__card {
    display: grid;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    background:
      radial-gradient(circle at top left, rgb(255 255 255 / 0.8), transparent 42%),
      linear-gradient(180deg, rgb(var(--color-background-rgb) / 1), rgb(var(--color-background-rgb) / 0.92));
    box-shadow: 0 20px 48px rgb(20 24 20 / 0.08);
  }

  .kids-curated-collection__media {
    aspect-ratio: 1 / 0.86;
    background: #f7f1ea;
    overflow: hidden;
  }

  .kids-curated-collection__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kids-curated-collection__body {
    display: grid;
    gap: 0.8rem;
    padding: 1.25rem;
  }

  .kids-curated-collection__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    justify-content: space-between;
  }

  .kids-curated-collection__price {
    font-size: 1rem;
    font-weight: 600;
  }

  .kids-curated-collection__body h3,
  .kids-curated-collection__body p {
    margin: 0;
  }

  .kids-curated-collection__body h3 {
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .kids-curated-collection__body p {
    color: rgb(var(--color-foreground-rgb) / 0.68);
    line-height: 1.65;
  }

  .kids-curated-collection__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: currentcolor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    width: fit-content;
  }

  @media screen and (min-width: 750px) {
    .kids-curated-collection__header {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .kids-curated-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1200px) {
    .kids-curated-collection__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kids Curated Collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated nursery favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A polished product mix for diapers and socks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Use this curated strip to preview a premium merchandising direction while your live Shopify catalog is being finalized."
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Note label",
      "default": "Merchandising focus"
    },
    {
      "type": "text",
      "id": "note_value",
      "label": "Note value",
      "default": "Soft textures, calm tones, parent-first clarity"
    },
    {
      "type": "header",
      "content": "Product 1"
    },
    {
      "type": "text",
      "id": "product_1_badge",
      "label": "Badge",
      "default": "Best seller"
    },
    {
      "type": "text",
      "id": "product_1_title",
      "label": "Title",
      "default": "CloudSoft Day Diapers"
    },
    {
      "type": "text",
      "id": "product_1_price",
      "label": "Price",
      "default": "$26.00"
    },
    {
      "type": "textarea",
      "id": "product_1_description",
      "label": "Description",
      "default": "Feather-soft daytime diapers with a breathable outer layer and easy-change stretch tabs."
    },
    {
      "type": "url",
      "id": "product_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Product 2"
    },
    {
      "type": "text",
      "id": "product_2_badge",
      "label": "Badge",
      "default": "Bundle pick"
    },
    {
      "type": "text",
      "id": "product_2_title",
      "label": "Title",
      "default": "DreamDry Night Diapers"
    },
    {
      "type": "text",
      "id": "product_2_price",
      "label": "Price",
      "default": "$30.00"
    },
    {
      "type": "textarea",
      "id": "product_2_description",
      "label": "Description",
      "default": "Overnight absorbency with a snug waistband and gentle inner lining for uninterrupted sleep."
    },
    {
      "type": "url",
      "id": "product_2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Product 3"
    },
    {
      "type": "text",
      "id": "product_3_badge",
      "label": "Badge",
      "default": "Gift-ready"
    },
    {
      "type": "text",
      "id": "product_3_title",
      "label": "Title",
      "default": "CozyStep Crew Socks"
    },
    {
      "type": "text",
      "id": "product_3_price",
      "label": "Price",
      "default": "$14.00"
    },
    {
      "type": "textarea",
      "id": "product_3_description",
      "label": "Description",
      "default": "A soft cotton-rich set with playful tones, gentle ribbing, and everyday comfort."
    },
    {
      "type": "url",
      "id": "product_3_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Product 4"
    },
    {
      "type": "text",
      "id": "product_4_badge",
      "label": "Badge",
      "default": "New arrival"
    },
    {
      "type": "text",
      "id": "product_4_title",
      "label": "Title",
      "default": "SnuggleFit Ankle Socks"
    },
    {
      "type": "text",
      "id": "product_4_price",
      "label": "Price",
      "default": "$12.00"
    },
    {
      "type": "textarea",
      "id": "product_4_description",
      "label": "Description",
      "default": "Tiny-foot essentials with a stay-put cuff, soft stretch, and a cozy nursery palette."
    },
    {
      "type": "url",
      "id": "product_4_link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
