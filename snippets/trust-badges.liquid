{% comment %}
  Trust Badges
  Dynamic - uses theme settings, falls back to defaults
{% endcomment %}

{% liquid
  assign badge_1 = settings.trust_badge_1
  assign badge_2 = settings.trust_badge_2
  assign badge_3 = settings.trust_badge_3

  if badge_1 == blank
    assign badge_1 = 'Free Shipping'
  endif
  if badge_2 == blank
    assign badge_2 = 'Free Returns'
  endif
  if badge_3 == blank
    assign badge_3 = 'Secure Checkout'
  endif
%}

<div class="trust-badges">
  <div class="trust-badges__grid">
    {% if badge_1 != blank %}
    <div class="trust-badge">
      <span class="trust-badge__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 18H19L10 9L5 18Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M19 9H5V18H19V9Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
        </svg>
      </span>
      <span class="trust-badge__text">{{ badge_1 }}</span>
    </div>
    {% endif %}
    {% if badge_2 != blank %}
    <div class="trust-badge">
      <span class="trust-badge__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 12H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M3 6H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M3 18H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M9 12L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="trust-badge__text">{{ badge_2 }}</span>
    </div>
    {% endif %}
    {% if badge_3 != blank %}
    <div class="trust-badge">
      <span class="trust-badge__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 11V8C8 6.93913 8.42143 5.92172 9.17157 5.17157C9.92172 4.42143 10.9391 4 12 4C13.0609 4 14.0783 4.42143 14.8284 5.17157C15.5786 5.92172 16 6.93913 16 8V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="12" cy="16" r="2" fill="currentColor"/>
        </svg>
      </span>
      <span class="trust-badge__text">{{ badge_3 }}</span>
    </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .trust-badges {
    margin: 1.25rem 0;
    padding: 1rem;
    background: rgb(var(--color-background-rgb) / 0.5);
    border-radius: 16px;
    border: 1px solid rgb(var(--color-border-rgb) / 0.2);
  }

  .trust-badges__grid {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    flex: 1;
    text-align: center;
  }

  .trust-badge__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb) / 0.05);
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .trust-badge__text {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    line-height: 1.2;
  }
{% endstylesheet %}
