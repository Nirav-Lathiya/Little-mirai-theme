{% comment %}
  Collection product card with theme quick add support.
  Expects:
  - product
  - section_id
  - anchor_id
{% endcomment %}

{% if product %}
  {% liquid
    assign selected_variant = product.selected_or_first_available_variant
    assign featured_image = selected_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.featured_image
    assign product_url = selected_variant.url | default: product.url
    assign has_discount = false
    assign badge_text = blank
    assign featured_media_url = blank

    if selected_variant.compare_at_price > selected_variant.price
      assign has_discount = true
      assign discount_percent = selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0 | divided_by: selected_variant.compare_at_price | round
      assign badge_text = '-' | append: discount_percent | append: '%'
    endif

    if settings.transition_to_main_product and featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 720
    endif
  %}

  <product-card
    class="collection-product-card product-card"
    data-product-id="{{ product.id }}"
    {% if settings.transition_to_main_product %}
      data-product-transition="true"
      {% if featured_media_url != blank %}
        data-featured-media-url="{{ featured_media_url }}"
      {% endif %}
      on:click="/handleViewTransition"
    {% endif %}
  >
    <div class="collection-product-card__inner">
      <div class="collection-product-card__media-shell">
        <a
          id="{{ anchor_id }}"
          href="{{ product_url }}"
          class="collection-product-card__media-link"
          ref="productCardLink"
        >
          <div
            class="collection-product-card__media"
            ref="cardGallery"
            {% if settings.transition_to_main_product %}
              data-view-transition-to-main-product
            {% endif %}
          >
            {% if featured_image %}
              {{
                featured_image
                | image_url: width: 720
                | image_tag:
                  loading: 'lazy',
                  class: 'collection-product-card__image',
                  widths: '240, 360, 480, 720',
                  sizes: '(min-width: 1200px) 23vw, (min-width: 750px) 30vw, 44vw',
                  alt: featured_image.alt | default: product.title,
                  ref: 'imagesToTransition[]'
              }}
            {% else %}
              <div class="collection-product-card__placeholder" aria-hidden="true">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </a>

        {% if product.available == false %}
          <span class="collection-product-card__badge collection-product-card__badge--soldout">
            {{ 'content.product_badge_sold_out' | t }}
          </span>
        {% elsif has_discount %}
          <span class="collection-product-card__badge">
            {{ badge_text }}
          </span>
        {% endif %}
      </div>

      <div class="collection-product-card__body">
        <h3 class="collection-product-card__title">
          <a
            href="{{ product_url }}"
            ref="productTitleLink"
          >
            {{ product.title }}
          </a>
        </h3>

        <product-price class="collection-product-card__price">
          {% render 'price', product_resource: product, show_sale_price_first: true %}
        </product-price>

        <div class="collection-product-card__quick-add">
          {% if product.available %}
            {% capture quick_add_label %}+ Quick Add{% endcapture %}
            {% render 'quick-add',
              product: product,
              section_id: section_id,
              add_to_cart_text: quick_add_label,
              choose_options_text: quick_add_label
            %}
          {% else %}
            <button
              class="collection-product-card__soldout-button"
              type="button"
              disabled
            >
              {{ 'content.product_badge_sold_out' | t }}
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </product-card>
{% endif %}
