{% doc %}
  Product Information Content

  Renders product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.
{% enddoc %}

{% liquid
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if product_media_size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

  capture product_context
    echo product.title
    echo ' '
    echo product.type
    echo ' '
    echo product.vendor
    echo ' '
    echo product.tags | join: ' '
  endcapture
  assign product_context = product_context | downcase

  assign story_kicker = 'Little everyday essential'
  assign story_summary = product.description | strip_html | strip | truncatewords: 26
  assign promise_1 = 'Soft-touch comfort'
  assign promise_2 = 'Easy-to-scan details'
  assign promise_3 = 'Parent-first layout'
  assign review_message = 'Parents love the calmer, more premium presentation.'
  assign shipping_message = 'Free shipping over $75. Estimated delivery in 3 to 5 business days.'
  assign care_title = 'Why it works'
  assign care_message = 'This layout keeps the most reassuring product cues visible near the add-to-cart area.'

  if story_summary == blank
    assign story_summary = 'The product page now balances softness, clarity, and trust so the buying journey feels easier for parents.'
  endif

  if product_context contains 'diaper' or product_context contains 'nappy'
    assign story_kicker = 'Diapering essential'
    assign promise_1 = 'Dry-feel confidence'
    assign promise_2 = 'Soft leg and waist comfort'
    assign promise_3 = 'Routine-ready replenishment'
    assign review_message = 'Parents look for softness, absorbency, and easier repeat buying right away.'
    assign shipping_message = 'Fast nursery restock shipping and free delivery over $75.'
    assign care_title = 'Key diaper detail'
    assign care_message = 'Merchandising is centered on absorbency, comfort, and a more reassuring tone for sensitive-skin shoppers.'
  elsif product_context contains 'sock'
    assign story_kicker = 'Tiny-foot essential'
    assign promise_1 = 'Cozy knit softness'
    assign promise_2 = 'Stay-put stretch'
    assign promise_3 = 'Giftable everyday charm'
    assign review_message = 'Parents want to know these feel soft, stay on, and still look sweet enough to gift.'
    assign shipping_message = 'Perfect for gift bundles, top-ups, and everyday wardrobe refreshes.'
    assign care_title = 'Key sock detail'
    assign care_message = 'The page now surfaces tactile comfort, fit reassurance, and a boutique-style presentation much earlier.'
  endif
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>
<div
  class="product-information section section--{{ content_width }} spacing-style color-{{ settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}

  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}

    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endcapture %}

    {% capture details %}
      <div
        class="product-information__details-column"
        data-product-details-column
      >
        <div class="product-information__story-card">
          <span class="product-information__story-eyebrow">{{ story_kicker }}</span>
          <p class="product-information__story-summary">{{ story_summary }}</p>
          <div class="product-information__story-promises">
            <span>{{ promise_1 }}</span>
            <span>{{ promise_2 }}</span>
            <span>{{ promise_3 }}</span>
          </div>
        </div>
        <template data-product-detail-template>
          <div
            class="product-information__meta product-information__meta--rating"
            data-product-rating-placeholder
          >
            <div
              class="product-information__stars"
              aria-hidden="true"
            >
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span>{{ review_message }}</span>
          </div>
          <div
            class="product-information__meta product-information__meta--shipping"
            data-product-shipping-info
          >
            <p class="product-information__meta-title">Shipping</p>
            <p>{{ shipping_message }}</p>
          </div>
          <div
            class="product-information__meta product-information__meta--shipping"
            data-product-care-info
          >
            <p class="product-information__meta-title">{{ care_title }}</p>
            <p>{{ care_message }}</p>
          </div>
        </template>
        {{ product_details }}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}
  </div>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  .product-information__grid {
    display: grid;
    grid-column: 1 / -1;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .product-information__details-column,
  .product-details,
  .product-details > .group-block,
  .product-details > .group-block > .group-block-content {
    width: 100%;
  }

  .product-information__details-column {
    min-width: 0;
    display: grid;
    gap: 1rem;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  .product-details {
    order: 1;
    align-self: start;
  }

  .product-information__media {
    order: 0;
    min-width: 0;
    position: relative;
  }

  .product-information__media::after {
    content: '';
    position: absolute;
    inset: auto 8% -3rem;
    height: 10rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(232 205 170 / 0.34), transparent 72%);
    filter: blur(24px);
    z-index: -1;
  }

  .product-details > .group-block {
    border-radius: 28px;
    border: 1px solid rgb(var(--color-border-rgb) / 0.52);
    background:
      radial-gradient(circle at top left, rgb(255 255 255 / 0.82), transparent 38%),
      linear-gradient(180deg, rgb(var(--color-background-rgb) / 0.98), rgb(var(--color-background-rgb) / 0.92));
    box-shadow: 0 22px 50px rgb(20 20 15 / 0.08);
  }

  .product-details > .group-block > .group-block-content {
    gap: 16px;
  }

  .product-information__story-card {
    display: grid;
    gap: 0.85rem;
    padding: 1.15rem 1.2rem;
    border-radius: 24px;
    background:
      radial-gradient(circle at top left, rgb(255 255 255 / 0.76), transparent 38%),
      linear-gradient(180deg, rgb(var(--color-background-rgb) / 1), rgb(var(--color-background-rgb) / 0.94));
    border: 1px solid rgb(var(--color-border-rgb) / 0.48);
  }

  .product-information__story-eyebrow,
  .product-information__story-promises span {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: rgb(var(--color-foreground-rgb) / 0.7);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 0.78rem;
  }

  .product-information__story-summary {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.78);
    line-height: 1.7;
  }

  .product-information__story-promises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .product-details :is(product-price, variant-picker, .buy-buttons-block, .text-block.rte) {
    width: 100%;
  }

  .product-details product-price > * {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
  }

  .product-details .buy-buttons-block .product-form-buttons {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .product-details .product-form-buttons > *:not(.quantity-label, .quantity-rules, .volume-pricing) {
    min-width: 0;
  }

  .product-details .quantity-selector-wrapper,
  .product-details .quantity-selector {
    width: 100%;
    max-width: 100%;
  }

  .product-details .quantity-selector-wrapper {
    align-items: stretch;
  }

  .product-details .quantity-label {
    margin-block-end: 0;
  }

  .product-information__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid rgb(var(--color-border-rgb) / 0.7);
    border-radius: 12px;
    background: rgb(var(--color-background-rgb) / 0.78);
    color: rgb(var(--color-foreground-rgb) / 0.82);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .product-information__meta--shipping {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.25rem;
  }

  .product-information__meta p {
    margin: 0;
  }

  .product-information__meta-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.66);
  }

  .product-information__stars {
    display: inline-flex;
    gap: 0.25rem;
  }

  .product-information__stars span {
    width: 0.8rem;
    height: 0.8rem;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    background: #7c8c6b;
  }

  @media screen and (max-width: 749px) {
    .product-information__media,
    .product-information__details-column {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    .product-information__grid.product-information--media-none {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-information__grid:not(.product-information--media-none).product-information--media-left {
      grid-template-columns: minmax(0, 1.5fr) minmax(22rem, 1fr);
    }

    .product-information__grid:not(.product-information--media-none).product-information--media-right {
      grid-template-columns: minmax(22rem, 1fr) minmax(0, 1.5fr);
    }

    .product-information__grid.product-information--media-right .product-information__media {
      order: 1;
    }

    .product-information__grid.product-information--media-right .product-information__details-column {
      order: 0;
    }
  }

  @media screen and (min-width: 1200px) {
    .product-information__grid:not(.product-information--media-none).product-information--media-left {
      grid-template-columns: minmax(0, 60%) minmax(0, 40%);
    }

    .product-information__grid:not(.product-information--media-none).product-information--media-right {
      grid-template-columns: minmax(0, 40%) minmax(0, 60%);
    }
  }

  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }
{% endstylesheet %}
