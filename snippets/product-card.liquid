
{% liquid
  assign products = null

  if section.settings.recommendation_collection != blank
    assign collection_handle = section.settings.recommendation_collection.handle
    assign collection_obj = collections[collection_handle]
    
    if collection_obj != blank
      assign products = collection_obj.products
    endif

  endif

  if products == blank and product.collections.size > 0
    assign fallback_collection = product.collections.first
    assign products = collections[fallback_collection.handle].products
  endif

  if products == blank
    assign products = collections.all.products
  endif

  assign products = products | slice: 0, section.settings.max_products
%}
