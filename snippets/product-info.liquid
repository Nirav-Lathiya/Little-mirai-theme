{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign inventory_quantity = current_variant.inventory_quantity | default: 0
  assign minimum_quantity = current_variant.quantity_rule.min | default: 1
  assign trust_badge_1 = section_settings.trust_badge_1 | default: 'Free shipping'
  assign trust_badge_2 = section_settings.trust_badge_2 | default: 'Free returns'
  assign trust_badge_3 = section_settings.trust_badge_3 | default: 'Secure checkout'
  assign compare_at_visible = false

  if current_variant.compare_at_price > current_variant.price
    assign compare_at_visible = true
  endif

  assign stock_message = 'Made for everyday comfort'
  if inventory_quantity > 0
    assign stock_message = 'Only ' | append: inventory_quantity | append: ' left in stock'
  endif

  assign stock_note_visible = false
  if section_settings.enable_stock_urgency and inventory_quantity > 0 and inventory_quantity <= section_settings.stock_threshold
    assign stock_note_visible = true
  endif

  assign add_to_cart_text = 'Add to Cart'
  if current_variant.available != true
    assign add_to_cart_text = 'Sold Out'
  endif

  capture variants_json
    echo '['
    for variant in product.variants
      echo '{'
      echo '"id":'
      echo variant.id | json
      echo ','
      echo '"available":'
      echo variant.available | json
      echo ','
      echo '"option1":'
      echo variant.option1 | json
      echo ','
      echo '"option2":'
      echo variant.option2 | json
      echo ','
      echo '"option3":'
      echo variant.option3 | json
      echo ','
      echo '"price":'
      echo variant.price | money | json
      echo ','
      echo '"compare_at_price":'
      if variant.compare_at_price > variant.price
        echo variant.compare_at_price | money | json
      else
        echo 'null'
      endif
      echo ','
      echo '"inventory_quantity":'
      echo variant.inventory_quantity | default: 0 | json
      echo ','
      echo '"featured_media_id":'
      echo variant.featured_media.id | json
      echo '}'
      unless forloop.last
        echo ','
      endunless
    endfor
    echo ']'
  endcapture
%}

<div class="product-info" data-product-info>
  <div class="product-info__header">
    <h1 class="product-title">{{ product.title }}</h1>
    <div class="product-price">
      <span class="product-price__current" data-product-price>{{ current_variant.price | money }}</span>
      <span
        class="product-price__compare"
        data-product-compare
        {% unless compare_at_visible %}
          hidden
        {% endunless %}
      >
        {{ current_variant.compare_at_price | money }}
      </span>
    </div>
    <div class="product-rating" aria-label="Rated 5 out of 5">
      <span class="product-rating__stars">★★★★★</span>
      <span class="product-rating__text">Loved by parents</span>
    </div>
  </div>

  <ul class="product-benefits">
    <li>Ultra-soft breathable cotton</li>
    <li>Safe for newborn skin</li>
    <li data-stock-benefit>{{ stock_message }}</li>
  </ul>

  <div
    class="product-stock-note"
    data-stock-note
    {% unless stock_note_visible %}
      hidden
    {% endunless %}
  >
    {{ stock_message }}
  </div>

  {% unless product.has_only_default_variant %}
    <div class="product-options">
      {% for option in product.options_with_values %}
        <fieldset class="product-option" data-option-position="{{ option.position }}">
          <legend class="product-option__label">{{ option.name }}</legend>
          <div class="product-option__values">
            {% for value in option.values %}
              <button
                type="button"
                class="product-option__value{% if option.selected_value == value %} is-selected{% endif %}"
                data-option-value="{{ value | escape }}"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        </fieldset>
      {% endfor %}
    </div>
  {% endunless %}

  {% assign product_form_id = 'MainProductForm-' | append: section_id %}
  {% form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' %}
    <input
      type="hidden"
      name="id"
      value="{{ current_variant.id }}"
      data-variant-id
    >

    <div class="product-quantity">
      <label class="product-quantity__label" for="ProductQuantity-{{ section_id }}">Quantity</label>
      <div class="product-quantity__control">
        <button type="button" class="product-quantity__button" data-qty-change="-1">-</button>
        <input
          id="ProductQuantity-{{ section_id }}"
          class="product-quantity__input"
          type="number"
          name="quantity"
          value="{{ minimum_quantity }}"
          min="{{ minimum_quantity }}"
          data-qty-input
        >
        <button type="button" class="product-quantity__button" data-qty-change="1">+</button>
      </div>
    </div>

    <button
      type="submit"
      name="add"
      class="add-to-cart"
      data-add-to-cart
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      {{ add_to_cart_text }}
    </button>

    <button
      type="button"
      class="buy-now"
      data-buy-now
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      Buy Now
    </button>
  {% endform %}

  <div class="trust-icons">
    <div class="trust-icons__item"><span aria-hidden="true">🚚</span>{{ trust_badge_1 }}</div>
    <div class="trust-icons__item"><span aria-hidden="true">↩️</span>{{ trust_badge_2 }}</div>
    <div class="trust-icons__item"><span aria-hidden="true">🔒</span>{{ trust_badge_3 }}</div>
  </div>

  {% render 'product-accordions', product: product %}

  <script type="application/json" data-product-variants>
    {{ variants_json }}
  </script>
</div>
