{%- doc -%}
  Simple card gallery for product cards - displays single featured image
{%- enddoc -%}

{% liquid
  assign product = closest.product | default: product
%}

<div class="card-gallery" style="aspect-ratio: 1 / 1;">
  {{ children }}
</div>

{% stylesheet %}
.card-gallery {
  overflow: hidden;
  position: relative;
  width: 100%;
  background: #f7f5f2;
  border-radius: 12px;
}

.card-gallery img,
.card-gallery video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
{% endstylesheet %}
